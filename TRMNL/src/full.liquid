{% render 'head_assets' %}
<div class="layout layout--col h--full gap--small">
  <div class="w--full flex flex--row flex--between flex--center-y gap--xsmall border--h-50 pb--2">
    <div>
      <span class="title lg:title--large">{{ primary_label }} prices</span>
      <span class="label label--small lg:label--base">All-in · {{ primary_unit }}</span>
    </div>
    <span class="label label--small lg:label--base">{{ local_day }}</span>
  </div>

  {% if primary_data.size > 0 %}
    <div class="w--full grid gap--small">
      {% capture current_caption %}Now · {{ p_current_from_local | date: '%H:%M' }}–{{ p_current_till_local | date: '%H:%M' }}{% endcapture %}
      {% render 'price_card', value: p_current_total, caption: current_caption, class: 'col--span-4 inverse', value_class: 'value--large lg:value--xlarge' %}
      <div class="col--span-8 grid grid--cols-3 gap--small">
        {% render 'price_card', value: p_average_total, caption: 'Daily average', value_class: 'value--small lg:value--large' %}
        {% capture low_caption %}Lowest · {{ p_lowest_from_local | date: '%H:%M' }}{% endcapture %}
        {% render 'price_card', value: p_lowest_total, caption: low_caption, value_class: 'value--small lg:value--large' %}
        {% capture high_caption %}Highest · {{ p_highest_from_local | date: '%H:%M' }}{% endcapture %}
        {% render 'price_card', value: p_highest_total, caption: high_caption, value_class: 'value--small lg:value--large' %}
      </div>
    </div>
    {% render 'energy_chart', id: 'frank-chart-full', series: primary_data, primary_label: primary_label, utc_offset: utc_offset, now_epoch: now_epoch, local_now_epoch: local_now_epoch %}
    {% if secondary_data.size > 0 %}
      <div class="w--full flex flex--row flex--between flex--center-y gap--xsmall border p--2 lg:p--3">
        <span class="label lg:label--large">{{ secondary_label }} now</span>
        <span class="value value--tnums value--xsmall lg:value--small text--bold">€{{ s_current_total | round: 3 }}</span>
        <span class="label label--small lg:label--base">{{ secondary_unit }} · avg €{{ s_average_total | round: 3 }}</span>
      </div>
    {% endif %}
  {% else %}
    <div class="w--full grow flex flex--col flex--center gap">
      <span class="title lg:title--xlarge">Price data unavailable</span>
      <span class="description lg:description--large">Frank Energie did not return {{ primary_label | downcase }} prices.</span>
    </div>
  {% endif %}
</div>
{% render 'frank_title_bar', svg_logo: svg_logo, title: trmnl.plugin_settings.instance_name %}
