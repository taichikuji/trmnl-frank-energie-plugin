{% render 'head_assets' %}
<div class="layout layout--col h--full gap--space-between">
  <div class="w--full flex flex--row flex--between flex--center-y gap--xsmall border--h-50 pb--1">
    <div>
      <span class="title lg:title--large">{{ primary_label }} prices</span>
      <span class="label label--small lg:label--base">All-in · {{ primary_unit }}</span>
    </div>
    <span class="label label--small lg:label--base">{{ local_time }}</span>
  </div>

  {% if primary_data.size > 0 %}
    <div class="w--full h--min-0 grow grid grid--cols-12 gap--small">
      <div class="col--span-5 grid grid--cols-2 gap--xsmall">
        {% capture current_caption %}Now · {{ p_delta_percent }}% vs avg{% endcapture %}
        {% render 'price_card', value: p_current_total, caption: current_caption, class: 'inverse', value_class: 'value--small lg:value--large', padding_class: 'p--1 lg:p--2' %}
        {% render 'price_card', value: p_average_total, caption: 'Daily average', padding_class: 'p--1 lg:p--2' %}
        {% capture low_caption %}Lowest · {{ p_lowest_from_local | date: '%H:%M' }}{% endcapture %}
        {% render 'price_card', value: p_lowest_total, caption: low_caption, padding_class: 'p--1 lg:p--2' %}
        {% capture high_caption %}Highest · {{ p_highest_from_local | date: '%H:%M' }}{% endcapture %}
        {% render 'price_card', value: p_highest_total, caption: high_caption, padding_class: 'p--1 lg:p--2' %}
      </div>
      {% render 'energy_chart', id: 'frank-chart-half-horizontal', chart_class: 'col--span-7', series: primary_data, primary_label: primary_label, utc_offset: utc_offset, now_epoch: now_epoch, local_now_epoch: local_now_epoch %}
    </div>
  {% else %}
    <div class="w--full grow flex flex--col flex--center gap">
      <span class="title lg:title--xlarge">Price data unavailable</span>
    </div>
  {% endif %}
</div>
{% render 'frank_title_bar', svg_logo: svg_logo, title: trmnl.plugin_settings.instance_name %}
