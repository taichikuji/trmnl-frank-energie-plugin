{% render 'head_assets' %}
<div class="layout layout--col gap--distribute frank-board frank-board--half_horizontal">
  <div class="frank-heading border--h-50 pb--2">
    <div class="frank-heading-copy">
      <span class="title lg:title--large">{{ primary_label }} prices</span>
      <span class="label label--small lg:label--base">All-in · {{ primary_unit }}</span>
    </div>
    <span class="label label--small lg:label--base frank-heading-meta">{{ local_time }}</span>
  </div>

  {% if primary_data.size > 0 %}
    <div class="frank-split">
      <div class="frank-mini-grid">
        {% capture current_caption %}Now · {{ p_trend }}{% endcapture %}
        {% render 'price_card', value: p_current_total, caption: current_caption, class: 'frank-card--current bg--yellow text--black', value_class: 'value--small lg:value--large' %}
        {% render 'price_card', value: p_average_total, caption: 'Daily average' %}
        {% capture low_caption %}Lowest · {{ p_lowest_from_local | date: '%H:%M' }}{% endcapture %}
        {% render 'price_card', value: p_lowest_total, caption: low_caption %}
        {% capture high_caption %}Highest · {{ p_highest_from_local | date: '%H:%M' }}{% endcapture %}
        {% render 'price_card', value: p_highest_total, caption: high_caption %}
      </div>
      {% render 'energy_chart', id: 'frank-chart-half-horizontal', series: primary_data, primary_label: primary_label, utc_offset: utc_offset, now_epoch: now_epoch, local_now_epoch: local_now_epoch %}
    </div>
  {% else %}
    <div class="frank-empty"><span class="title lg:title--xlarge">Price data unavailable</span></div>
  {% endif %}
</div>
{% render 'frank_title_bar', svg_logo: svg_logo, title: trmnl.plugin_settings.instance_name, instance: primary_label %}
