<div class="layout layout--col h--full gap--small">
  {% render 'price_header', title: primary_label, unit: primary_unit, timestamp: local_time %}

  {% if primary_data.size > 0 %}
    {% capture current_caption %}Now · {{ p_trend }}{% endcapture %}
    {% render 'price_card', value: p_current_total, caption: current_caption, class: 'inverse grow basis--0', value_class: 'value--large lg:value--xlarge' %}
    <div class="w--full grow basis--0 grid grid--cols-2 gap--xsmall">
      {% capture low_caption %}Lowest · {{ p_lowest_from_local | date: '%H:%M' }}{% endcapture %}
      {% render 'price_card', value: p_lowest_total, caption: low_caption %}
      {% capture high_caption %}Highest · {{ p_highest_from_local | date: '%H:%M' }}{% endcapture %}
      {% render 'price_card', value: p_highest_total, caption: high_caption %}
    </div>
  {% else %}
    <div class="w--full grow flex flex--col flex--center gap">
      <span class="title lg:title--xlarge">Price data unavailable</span>
    </div>
  {% endif %}
</div>
