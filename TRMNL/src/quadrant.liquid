<div class="layout layout--col gap--distribute frank-board frank-board--quadrant">
  <div class="frank-heading border--h-50 pb--2">
    <div class="frank-heading-copy">
      <span class="title lg:title--large">{{ primary_label }}</span>
      <span class="label label--small lg:label--base">All-in · {{ primary_unit }}</span>
    </div>
    <span class="label label--small lg:label--base frank-heading-meta">{{ local_time }}</span>
  </div>

  {% if primary_data.size > 0 %}
    {% capture current_caption %}Now · {{ p_trend }}{% endcapture %}
    {% render 'price_card', value: p_current_total, unit: primary_unit, caption: current_caption, class: 'frank-card--current frank-card--compact bg--yellow text--black', value_class: 'value--small' %}
    <div class="frank-overview">
      {% capture low_caption %}Lowest · {{ p_lowest_from_local | date: '%H:%M' }}{% endcapture %}
      {% render 'price_card', value: p_lowest_total, caption: low_caption, value_class: 'value--xsmall' %}
      {% capture high_caption %}Highest · {{ p_highest_from_local | date: '%H:%M' }}{% endcapture %}
      {% render 'price_card', value: p_highest_total, caption: high_caption, value_class: 'value--xsmall' %}
    </div>
  {% else %}
    <div class="frank-empty"><span class="title lg:title--xlarge">Price data unavailable</span></div>
  {% endif %}
</div>
{% render 'frank_title_bar', svg_logo: svg_logo, title: trmnl.plugin_settings.instance_name, instance: primary_label %}
