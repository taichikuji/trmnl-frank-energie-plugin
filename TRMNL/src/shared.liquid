<style>
  .frank-board { gap: 8px; }
  .frank-heading { display: flex; align-items: baseline; justify-content: space-between; width: 100%; gap: 10px; }
  .frank-heading-copy { min-width: 0; }
  .frank-heading-meta { white-space: nowrap; }
  .frank-overview { display: grid; grid-template-columns: 1.35fr repeat(3, minmax(0, 1fr)); gap: 8px; width: 100%; }
  .frank-card { position: relative; box-sizing: border-box; width: 100%; min-width: 0; padding: 8px 10px 8px 14px; border: 1px solid currentColor; overflow: hidden; }
  .frank-card-rail { position: absolute; inset: 0 auto 0 0; width: 5px; }
  .frank-card--current, .frank-card--current .value, .frank-card--current .label { color: var(--black) !important; -webkit-text-fill-color: var(--black) !important; }
  .frank-card .value { display: block; line-height: 1; white-space: nowrap; }
  .frank-card--compact .value { display: inline; }
  .frank-card .frank-unit { margin-left: 3px; }
  .frank-card .frank-caption { display: block; margin-top: 4px; }
  .frank-chart { width: 100%; min-height: 0; flex: 1 1 auto; }
  .frank-secondary { display: flex; align-items: center; justify-content: space-between; gap: 10px; width: 100%; padding: 5px 10px; border: 1px solid currentColor; }
  .frank-secondary-value { white-space: nowrap; font-weight: bold; }
  .frank-empty { margin: auto; text-align: center; }
  .frank-split { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 10px; width: 100%; min-height: 0; flex: 1 1 auto; }
  .frank-mini-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px; min-height: 0; }
  .frank-board--half_horizontal .frank-card { padding: 5px 7px 5px 11px; }
  .frank-board--half_horizontal .frank-card .frank-caption { margin-top: 2px; }
  .frank-board--half_vertical .frank-card--current { min-height: 106px; padding: 6px 12px 6px 16px; }
  .frank-board--half_vertical .frank-chart { min-height: 145px; }
  .frank-three-up { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; width: 100%; }
  .frank-board--quadrant .frank-card--current { min-height: 76px; padding: 6px 10px 6px 14px; }
  .frank-board--quadrant .frank-overview { grid-template-columns: 1fr 1fr; gap: 6px; }
  .frank-board--quadrant .frank-heading { gap: 5px; }
  .screen--1bit:not([class*="screen--color-"]) .frank-card--current,
  .screen--2bit:not([class*="screen--color-"]) .frank-card--current,
  .screen--4bit:not([class*="screen--color-"]) .frank-card--current { background: var(--white) !important; background-image: none !important; }
  .screen--1bit:not([class*="screen--color-"]) .frank-card--current .frank-card-rail,
  .screen--2bit:not([class*="screen--color-"]) .frank-card--current .frank-card-rail,
  .screen--4bit:not([class*="screen--color-"]) .frank-card--current .frank-card-rail { background: var(--black) !important; }
  .screen--lg .frank-board { gap: 14px; }
  .screen--lg .frank-overview { gap: 14px; }
  .screen--lg .frank-card { padding: 14px 16px 14px 22px; }
  .screen--lg .frank-card-rail { width: 7px; }
  .screen--lg .frank-secondary { padding: 10px 16px; }
  .screen--lg .frank-split { gap: 18px; }
  .screen--lg .frank-mini-grid, .screen--lg .frank-three-up { gap: 12px; }
  .screen--lg .frank-board--half_vertical .frank-chart { min-height: 320px; }
  .screen--lg.screen--portrait .frank-board--full .frank-overview { grid-template-columns: repeat(2, minmax(0, 1fr)); }
</style>

{% template frank_title_bar %}
  <div class="title_bar">
    <img class="image image--adaptive" src="data:image/svg+xml;base64,{{ svg_logo | base64_encode }}" alt="Frank Energie">
    <span class="title">{{ title | default: 'Frank Energie' | escape }}</span>
    <span class="instance">{{ instance }}</span>
  </div>
{% endtemplate %}

{% template price_card %}
  <div class="frank-card {{ class }}">
    <span class="frank-card-rail {% if class contains 'frank-card--current' %}bg--red{% else %}bg--black{% endif %}"></span>
    <div>
      <span class="value value--tnums {{ value_class | default: 'value--small lg:value--base' }}">€{{ value | round: 3 }}</span>
      {% if unit != blank %}<span class="label label--small lg:label--base frank-unit">{{ unit }}</span>{% endif %}
    </div>
    <span class="label label--small lg:label--base frank-caption" data-clamp="1">{{ caption }}</span>
  </div>
{% endtemplate %}

{% template energy_chart %}
  <div id="{{ id }}" class="frank-chart w--full grow {{ chart_class }}"></div>
  <script>
    (function () {
      var raw = [
        {% for item in series %}
          {% assign total = item.marketPrice | plus: item.marketPriceTax | plus: item.sourcingMarkupPrice | plus: item.energyTaxPrice %}
          {% assign from_utc_epoch = item.from | date: '%s' | plus: 0 %}
          {% assign from_epoch = from_utc_epoch | plus: utc_offset %}
          {% assign till_epoch = item.till | date: '%s' | plus: 0 %}
          { x: {{ from_epoch | times: 1000 }}, y: {{ total | round: 5 }}, current: {% if now_epoch >= from_utc_epoch and now_epoch < till_epoch %}true{% else %}false{% endif %} }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ];
      function ready(callback) {
        var tries = 0;
        (function attempt() {
          if (window.Highcharts) return callback();
          if (++tries < 200) setTimeout(attempt, 50);
        })();
      }
      function build() {
        var el = "{{ id }}";
        if (!window.TRMNLCharts || !window.TRMNLPaint) {
          var screen = document.getElementById(el).closest(".screen");
          var bwry = screen && screen.className.indexOf("color-4bwry") !== -1;
          return Highcharts.chart(el, {
            chart: { type: "column", height: null, animation: false, backgroundColor: "transparent", spacing: [4, 4, 2, 4] },
            plotOptions: { series: { animation: false, enableMouseTracking: false }, column: { borderWidth: 1, borderColor: "#000", pointPadding: 0.04, groupPadding: 0.03 } },
            series: [{ data: raw.map(function (point) { return { x: point.x, y: point.y, color: point.current ? (bwry ? "#e60012" : "#000") : (bwry ? "#f6d32d" : "#aaa") }; }), showInLegend: false }],
            xAxis: { type: "datetime", tickPixelInterval: 100, labels: { format: "{value:%H:%M}" }, plotLines: [{ value: {{ local_now_epoch | times: 1000 }}, color: "#000", width: 2, dashStyle: "Dash", zIndex: 5 }] },
            yAxis: { title: { text: null }, tickAmount: 4, labels: { format: "€{value:.2f}" } },
            title: { text: null }, tooltip: { enabled: false }, credits: { enabled: false }
          });
        }
        TRMNLCharts.watch(el, function () {
          var px = function (value) { return TRMNLPaint.px(value, { el: el }); };
          var base = TRMNLCharts.paint("yellow-50", { el: el });
          var active = TRMNLCharts.paint("red-50", { el: el });
          var ink = TRMNLPaint.textColor("default", { el: el });
          var points = raw.map(function (point) {
            return { x: point.x, y: point.y, color: point.current ? active : base };
          });
          return Highcharts.chart(el, TRMNLCharts.merge(TRMNLCharts.options({ el: el }), {
            chart: { type: "column", height: null, spacing: px([4, 4, 2, 4]) },
            plotOptions: {
              series: { animation: false, enableMouseTracking: false },
              column: { borderWidth: px(1), borderColor: ink, pointPadding: 0.04, groupPadding: 0.03 }
            },
            series: [{ data: points, name: "{{ primary_label }}", showInLegend: false }],
            xAxis: {
              type: "datetime",
              tickPixelInterval: px(100),
              labels: { format: "{value:%H:%M}" },
              plotLines: [{ value: {{ local_now_epoch | times: 1000 }}, color: ink, width: px(2), dashStyle: "Dash", zIndex: 5 }]
            },
            yAxis: {
              title: { text: null },
              tickAmount: 4,
              labels: { format: "€{value:.2f}" }
            },
            title: { text: null },
            tooltip: { enabled: false },
            credits: { enabled: false }
          }));
        });
      }
      ready(function () {
        function afterLayout() {
          requestAnimationFrame(build);
        }
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", afterLayout);
        } else {
          afterLayout();
        }
      });
    })();
  </script>
{% endtemplate %}
