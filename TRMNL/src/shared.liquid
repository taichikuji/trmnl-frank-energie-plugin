{% assign resource_type = trmnl.plugin_settings.custom_fields_values.resource_type | default: 'Electricity' | downcase %}
{% assign market_prices = data.marketPrices %}
{% if resource_type == 'gas' %}
  {% assign primary_data = market_prices.gasPrices %}
  {% assign primary_label = 'Gas' %}
  {% assign primary_unit = '€/m³' %}
  {% assign secondary_data = market_prices.electricityPrices %}
  {% assign secondary_label = 'Electricity' %}
  {% assign secondary_unit = '€/kWh' %}
{% else %}
  {% assign primary_data = market_prices.electricityPrices %}
  {% assign primary_label = 'Electricity' %}
  {% assign primary_unit = '€/kWh' %}
  {% assign secondary_data = market_prices.gasPrices %}
  {% assign secondary_label = 'Gas' %}
  {% assign secondary_unit = '€/m³' %}
{% endif %}

{% assign now_epoch = 'now' | date: '%s' | plus: 0 %}
{% assign utc_offset = trmnl.user.utc_offset | default: 0 | plus: 0 %}
{% assign local_now_epoch = now_epoch | plus: utc_offset %}
{% assign local_time = local_now_epoch | date: '%H:%M' %}
{% assign local_day = local_now_epoch | date: '%a %d %b' %}
{% assign p_sum = 0 %}
{% assign p_current_total = 0 %}
{% assign p_current_from = 0 %}
{% assign p_current_till = 0 %}
{% assign p_lowest_total = 0 %}
{% assign p_lowest_from = 0 %}
{% assign p_highest_total = 0 %}
{% assign p_highest_from = 0 %}
{% assign p_current_found = false %}
{% for item in primary_data %}
  {% assign total = item.marketPrice | plus: item.marketPriceTax | plus: item.sourcingMarkupPrice | plus: item.energyTaxPrice %}
  {% assign from_epoch = item.from | date: '%s' | plus: 0 %}
  {% assign till_epoch = item.till | date: '%s' | plus: 0 %}
  {% assign p_sum = p_sum | plus: total %}
  {% if forloop.first or total < p_lowest_total %}
    {% assign p_lowest_total = total %}
    {% assign p_lowest_from = from_epoch %}
  {% endif %}
  {% if forloop.first or total > p_highest_total %}
    {% assign p_highest_total = total %}
    {% assign p_highest_from = from_epoch %}
  {% endif %}
  {% if now_epoch >= from_epoch and now_epoch < till_epoch %}
    {% assign p_current_total = total %}
    {% assign p_current_from = from_epoch %}
    {% assign p_current_till = till_epoch %}
    {% assign p_current_found = true %}
  {% elsif forloop.first and p_current_found == false %}
    {% assign p_current_total = total %}
    {% assign p_current_from = from_epoch %}
    {% assign p_current_till = till_epoch %}
  {% endif %}
{% endfor %}
{% if primary_data.size > 0 %}{% assign p_average_total = p_sum | divided_by: primary_data.size %}{% else %}{% assign p_average_total = 0 %}{% endif %}
{% assign p_delta = p_current_total | minus: p_average_total %}
{% if p_average_total != 0 %}{% assign p_delta_percent = p_delta | times: 100 | divided_by: p_average_total | round %}{% else %}{% assign p_delta_percent = 0 %}{% endif %}
{% assign p_delta_abs = p_delta_percent | abs %}
{% if p_delta_percent < 0 %}
  {% assign p_trend = '↓ ' | append: p_delta_abs | append: '% below average' %}
{% elsif p_delta_percent > 0 %}
  {% assign p_trend = '↑ ' | append: p_delta_abs | append: '% above average' %}
{% else %}
  {% assign p_trend = 'At today’s average' %}
{% endif %}
{% assign p_current_from_local = p_current_from | plus: utc_offset %}
{% assign p_current_till_local = p_current_till | plus: utc_offset %}
{% assign p_lowest_from_local = p_lowest_from | plus: utc_offset %}
{% assign p_highest_from_local = p_highest_from | plus: utc_offset %}

{% assign s_sum = 0 %}
{% assign s_current_total = 0 %}
{% assign s_current_found = false %}
{% for item in secondary_data %}
  {% assign total = item.marketPrice | plus: item.marketPriceTax | plus: item.sourcingMarkupPrice | plus: item.energyTaxPrice %}
  {% assign from_epoch = item.from | date: '%s' | plus: 0 %}
  {% assign till_epoch = item.till | date: '%s' | plus: 0 %}
  {% assign s_sum = s_sum | plus: total %}
  {% if now_epoch >= from_epoch and now_epoch < till_epoch %}
    {% assign s_current_total = total %}
    {% assign s_current_found = true %}
  {% elsif forloop.first and s_current_found == false %}
    {% assign s_current_total = total %}
  {% endif %}
{% endfor %}
{% if secondary_data.size > 0 %}{% assign s_average_total = s_sum | divided_by: secondary_data.size %}{% else %}{% assign s_average_total = 0 %}{% endif %}

{% template head_assets %}
  <script src="https://trmnl.com/js/highcharts/12.3.0/highcharts.js"></script>
  <script src="https://trmnl.com/js/highcharts/12.3.0/pattern-fill.js"></script>
{% endtemplate %}

